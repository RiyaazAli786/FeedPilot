# Non-secret deployment settings for FeedPilot on bridge.reelsflow.io.
# The SSH password is NOT stored here: put SSH_PASSWORD in deploy/.deploy-secrets.env (gitignored)
# or set it as an environment variable, or the scripts will prompt for it.
DOMAIN=bridge.reelsflow.io
SERVER_IP=200.234.41.82
SSH_USER=root
SSH_PORT=22
# SHA256 host-key fingerprint seen on first connect (pinned so the scripts never talk to an impostor).
SSH_HOSTKEY=SHA256:RnatdJ+VIHanpLdhab2KRwG+o/EyCXyKplVlzupJ9JA
APP_NAME=bridgefeed
APP_DIR=/var/www/bridgefeed
DB_NAME=bridgefeed
DB_USER=bridgefeed
# Loopback-only port the API container listens on; nginx proxies the domain to it.
APP_PORT=5081
