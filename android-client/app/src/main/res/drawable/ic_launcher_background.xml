<?xml version="1.0" encoding="utf-8"?>
<!--
  FeedPilot graphite-to-midnight gradient with cool cyan and blue ambient halo.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Obsidian and graphite base -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108"
                android:startColor="#07141D"
                android:centerColor="#050A10"
                android:endColor="#020407" />
        </aapt:attr>
    </path>

    <!-- Cyan radial glow behind the FeedPilot emblem -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54" android:centerY="52"
                android:gradientRadius="48"
                android:startColor="#6625D9D0"
                android:endColor="#0025D9D0" />
        </aapt:attr>
    </path>

    <!-- Subtle electric-blue highlight ring -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54" android:centerY="48"
                android:gradientRadius="36"
                android:startColor="#334D7CFF"
                android:endColor="#004D7CFF" />
        </aapt:attr>
    </path>
</vector>
